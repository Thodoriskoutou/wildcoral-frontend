# Copy to `.env` and fill in. Vars are declared and validated in src/env.ts.

# --- Medusa (required) ---
MEDUSA_BACKEND_URL="http://localhost:9000"
MEDUSA_PUBLISHABLE_KEY=""

# --- Medusa (optional) ---
# Pin a region, or let the SDK resolve one from the visitor's country.
MEDUSA_DEFAULT_REGION_ID=""
MEDUSA_DEFAULT_COUNTRY_CODE="us"

# --- Stripe (optional until you enable payments) ---
STRIPE_KEY=""
STRIPE_REDIRECT_URL="http://localhost:5173/checkout/return"

# --- Contact form (optional) ---
# Messages from /contact are emailed through Resend (resend.com). Without a key the page shows your
# contact details but no form.
RESEND_API_KEY=""
# Where messages arrive (defaults to contactEmail in src/lib/site.ts):
CONTACT_TO_EMAIL=""
# Sender shown on the notification; use a domain you verified in Resend:
CONTACT_FROM_EMAIL=""

# --- Site metadata ---
SITE_NAME="My Store"
SITE_URL="http://localhost:5173"

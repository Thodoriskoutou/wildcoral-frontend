# Copy to `.env` and fill in. Vars are declared and validated in src/env.ts.

# --- Medusa (required) ---
MEDUSA_BACKEND_URL="http://localhost:9000"
MEDUSA_PUBLISHABLE_KEY=""

# --- Medusa (optional) ---
# Pin a region, or let the SDK resolve one from the visitor's country.
MEDUSA_DEFAULT_REGION_ID=""
MEDUSA_DEFAULT_COUNTRY_CODE="us"

# --- Storefront data cache (optional) ---
# Lifetimes are seconds. Leave empty, use null, or set to 0 to always SSR directly from Medusa.
JOURNAL_CACHE_TTL_SECONDS=""
PRODUCT_CACHE_TTL_SECONDS=""
# Required to authorize POST /api/cache/purge/journal and /api/cache/purge/products.
CACHE_PURGE_TOKEN=""

# --- Stripe (optional until you enable payments) ---
STRIPE_KEY=""
STRIPE_REDIRECT_URL="http://localhost:5173/checkout/return"

# --- Guest order tracking (optional) ---
# Code and verified guest-session lifetime in seconds. Defaults to 600 (10 minutes).
GUEST_ORDER_TRACKING_OTP_TTL_SECONDS="600"

# --- Site metadata ---
SITE_NAME="My Store"
SITE_URL="http://localhost:5173"
